{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bs2proctlgui",
  "version": "0.2.0",
  "identifier": "com.arne.bs2proctlgui",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BS2 Pro",
        "width": 400,
        "height": 704,
        "resizable": false,
        "decorations": false,
        "acceptFirstMouse": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
